<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>¡Feliz Cumple, Judith D!</title>
  <style>
    :root{
      --bg1:#0f1020;--bg2:#1b1e3b;--ac1:#8a5cff;--ac2:#00d4ff;--ac3:#ff7ac6;--text:#e9ecf1;
      --glass: rgba(255,255,255,.08);
    }
    *{box-sizing:border-box}
    body{
      margin:0;min-height:100vh;overflow:hidden;color:var(--text);
      background: radial-gradient(1200px 800px at 10% -10%, #273069 0%, transparent 60%),
                  radial-gradient(1000px 800px at 110% 10%, #2b0d4a 0%, transparent 60%),
                  linear-gradient(135deg,var(--bg1),var(--bg2));
      font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      display:grid;place-items:center;padding:24px;
    }
    .scene{position:relative;width:min(920px,100%);}
    canvas#confetti{position:fixed;inset:0;pointer-events:none;z-index:1}
    .balloon{position:absolute;bottom:-20vh;width:120px;height:150px;border-radius:60% 60% 60% 60%/70% 70% 40% 40%;
      filter: drop-shadow(0 10px 30px rgba(0,0,0,.4));opacity:.85;animation: floatUp linear infinite;
    }
    .balloon:after{content:"";position:absolute;left:50%;bottom:-30px;width:2px;height:34px;background:rgba(255,255,255,.6)}
    .b1{left:4%; background: linear-gradient(145deg, #ff9ad6, #ff5aa7); animation-duration: 18s}
    .b2{left:20%; background: linear-gradient(145deg, #97ffdf, #00d9b8); animation-duration: 20s; animation-delay: -4s}
    .b3{left:80%; background: linear-gradient(145deg, #ffd182, #ff8e2b); animation-duration: 17s; animation-delay: -2s}
    .b4{left:64%; background: linear-gradient(145deg, #9db2ff, #5a7bff); animation-duration: 22s; animation-delay: -6s}
    @keyframes floatUp{0%{transform:translateY(0) rotate(2deg)}100%{transform:translateY(-120vh) rotate(-6deg)}}
    .card{position:relative;z-index:2;background:var(--glass);backdrop-filter: blur(10px);
      border:1px solid rgba(255,255,255,.12); border-radius:24px; padding:28px; box-shadow: 0 20px 60px rgba(0,0,0,.35);
    }
    .header{display:flex;gap:18px;align-items:center;flex-wrap:wrap}
    .avatar{
      width:70px;height:70px;border-radius:50%;overflow:hidden;
      border:2px solid rgba(255,255,255,.6);
      display:grid;place-items:center;
      background: var(--glass);
    }
    .avatar img{width:100%;height:100%;object-fit:cover;}
    h1{margin:4px 0 0;font-size:clamp(28px,5vw,40px);line-height:1.1}
    .spark{background: linear-gradient(90deg,var(--ac2),var(--ac3),var(--ac1));
      -webkit-background-clip:text;background-clip:text;color:transparent;
      text-shadow: 0 0 30px rgba(255,255,255,.18);}
    .sub{opacity:.9;margin:8px 0 16px;font-size:clamp(14px,2.6vw,18px)}
    .chip{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;border:1px solid rgba(255,255,255,.16);
      background: rgba(255,255,255,.06);font-size:14px;margin:6px 8px 0 0}
    .heart{filter:drop-shadow(0 0 12px rgba(255,122,198,.6))}
    .wish{margin:18px 0 2px;display:grid;gap:10px}
    .wish li{list-style:none;padding:12px 14px;border-radius:14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12)}
    .actions{margin-top:18px;display:flex;gap:12px;flex-wrap:wrap}
    .btn{cursor:pointer;border:none;border-radius:14px;padding:12px 16px;font-weight:700;color:#0b0b14;
      background: linear-gradient(135deg,var(--ac2),var(--ac3)); box-shadow:0 10px 25px rgba(0,0,0,.3)}
    .btn.secondary{background: linear-gradient(135deg,#ffffff,#d6e4ff);}
    .footer{margin-top:14px;font-size:13px;opacity:.8}
    .twinkle{position:absolute;width:6px;height:6px;border-radius:50%;opacity:.9;animation: tw 2.2s infinite ease-in-out}
    @keyframes tw{0%{transform:scale(.4);opacity:.2}50%{transform:scale(1);opacity:1}100%{transform:scale(.4);opacity:.2}}
    @media (max-width:480px){
      .card{padding:22px}
      .wish li{padding:10px 12px}
    }
  </style>
</head>
<body>
  <canvas id="confetti"></canvas>
  <div class="balloon b1"></div>
  <div class="balloon b2"></div>
  <div class="balloon b3"></div>
  <div class="balloon b4"></div>

  <div class="scene">
    <div class="card">
      <div class="header">
        <div class="avatar">
          <!-- FOTO CORREGIDA -->
          <img src="https://dl.dropboxusercontent.com/scl/fi/lcpb0ic7w3oq1tjk3zuiv/FB_IMG_1756348455756.jpg?rlkey=c6nn0qu3mc6qj0n6f1ylqhl0t" alt="Foto de Judith D">
        </div>
        <div>
          <h1>¡Feliz Cumple, <span class="spark">Judith D</span>! 🎉🎂</h1>
          <p class="sub" id="typewriter">Que este nuevo año te encuentre llena de alegría, salud y logros. 💫</p>
          <div class="chip"><span class="heart">💖</span> Buena vibra para tus estudios</div>
          <div class="chip">📚 Enfoque + Constancia = Éxito</div>
        </div>
      </div>

      <ul class="wish">
        <li>🎯 Que alcances cada meta académica que te propongas.</li>
        <li>🧠 Que las ideas brillantes te visiten cuando más las necesites.</li>
        <li>🤝 Que te rodee gente que impulse tus sueños.</li>
        <li>🌟 Y que nunca falten razones para sonreír.</li>
      </ul>

      <div class="actions">
        <!-- BOTÓN DE MÚSICA -->
        <button class="btn" id="btnConfetti">🎵 Reproducir música</button>
        <button class="btn secondary" id="btnMensaje">Mensaje cariñoso</button>
      </div>

      <p class="footer">Con cariño, de parte de quien te admira un montón.</p>
    </div>
  </div>

  <script>
    const tw = document.getElementById('typewriter');
    const full = tw.textContent.trim();
    tw.textContent = '';
    let i = 0;
    function type(){
      if(i <= full.length){
        tw.textContent = full.slice(0, i++);
        setTimeout(type, 28);
      }
    }
    type();

    const canvas = document.getElementById('confetti');
    const ctx = canvas.getContext('2d');
    let W, H, pieces = [];
    function resize(){ W = canvas.width = innerWidth; H = canvas.height = innerHeight }
    addEventListener('resize', resize); resize();

    function addPiece(x, y){
      pieces.push({
        x, y,
        size: Math.random()*8+6,
        vy: Math.random()*2+1,
        vx: (Math.random()-0.5)*1.6,
        rot: Math.random()*Math.PI,
        vr: (Math.random()-0.5)*0.2,
        shape: Math.random()>0.5?'rect':'circle',
        hue: Math.floor(Math.random()*360)
      });
    }
    function burstConfetti(x=W/2, y=H/3){
      for(let i=0;i<140;i++) addPiece(x + (Math.random()-0.5)*80, y + (Math.random()-0.5)*40);
    }
    function tick(){
      ctx.clearRect(0,0,W,H);
      pieces.forEach((p)=>{
        p.vy += 0.01;
        p.x += p.vx; p.y += p.vy; p.rot += p.vr;
        if(p.y > H+20) {
          p.y = -10; p.x = Math.random()*W; p.vy = Math.random()*2+1;
        }
        ctx.save();
        ctx.translate(p.x, p.y); ctx.rotate(p.rot);
        ctx.fillStyle = `hsl(${p.hue} 90% 60%)`;
        if(p.shape==='rect') ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size);
        else { ctx.beginPath(); ctx.arc(0,0,p.size/2,0,Math.PI*2); ctx.fill(); }
        ctx.restore();
      });
      requestAnimationFrame(tick);
    }
    tick();
    setTimeout(()=>burstConfetti(), 500);

    // --- AUDIO DIRECTO DE DROPBOX ---
    const audio = new Audio("https://dl.dropboxusercontent.com/scl/fi/jopup3fb8tarb9iu69gid/Counting-Stars-MP3_160K.mp3?rlkey=426nj25ydrh37enih9bfm46xp");

    document.getElementById('btnConfetti').addEventListener('click', (e)=>{
      const r = e.currentTarget.getBoundingClientRect();
      burstConfetti(r.left + r.width/2, r.top + scrollY);
      audio.play().catch(()=>alert("Activa el sonido y vuelve a tocar 🎵"));
    });

    document.getElementById('btnMensaje').addEventListener('click',()=>{
      const lines = [
        'Me alegra un montón coincidir contigo. ✨',
        'Admiro tu dedicación y la luz que llevas a clase. 💡',
        'Que este sea tu año de brillar fuerte, Judith. 🌟' 
      ];
      alert(lines[Math.floor(Math.random()*lines.length)]);
    });

    for(let k=0;k<18;k++){
      const d=document.createElement('div');
      d.className='twinkle';
      d.style.left=Math.random()*100+'%';
      d.style.top=Math.random()*100+'%';
      d.style.background=`hsl(${Math.floor(Math.random()*360)} 90% 70%)`;
      d.style.animationDelay=(Math.random()*2)+'s';
      document.body.appendChild(d);
    }
  </script>
</body>
</html>
